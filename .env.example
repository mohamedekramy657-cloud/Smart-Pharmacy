# ---------------------------------------------------------------------------------------------
# Smart Pharmacy — environment configuration (copy to .env; NEVER commit real secrets)
# Generate secrets with:  openssl rand -base64 48   /   openssl rand -base64 32 (encryption key)
# ---------------------------------------------------------------------------------------------
NODE_ENV=production                      # development | test | production (production enforces secure settings)
POSTGRES_PASSWORD=change-me-strong-db-password   # docker-compose only
# DATABASE_URL=postgres://pharma:...@db:5432/pharma   # set by docker-compose; required otherwise
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

API_HOST=0.0.0.0                         # bind address (127.0.0.1 when behind the web proxy on one host)
API_PORT=4000
APP_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx   # HMAC key: CSRF tokens, IP hashing
DATA_ENCRYPTION_KEY=replace-with-base64-of-exactly-32-random-bytes=   # AES-256-GCM for webhook/MFA secrets

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=true                       # must be true in production (HTTPS)
COOKIE_SAMESITE=lax                      # lax | strict | none (none only for embedded/iframe deployments)
COOKIE_PARTITIONED=false                 # CHIPS; only with COOKIE_SAMESITE=none
TRUST_PROXY_HOPS=1                       # number of trusted reverse proxies in front of the API
ADMIN_MFA_REQUIRED=true                  # require TOTP for super-admin endpoints

WORKER_ENABLED=false                     # true = run background jobs inside the API process (single-node)
WORKER_POLL_MS=1000
LOG_LEVEL=info
METRICS_TOKEN=                           # if set, /api/metrics requires "Authorization: Bearer <token>"
SWAGGER_ENABLED=false                    # interactive API docs at /api/docs

EMAIL_PROVIDER=none                      # none | dev-log (dev-log is rejected in production)
SMS_PROVIDER=none
RATE_LIMIT_PER_MINUTE=300                # per client IP, all routes
AUTH_RATE_LIMIT_PER_MINUTE=10            # login/register/password change
FINDER_RATE_LIMIT_PER_MINUTE=60          # public medicine search

# Web (build-time for Next.js rewrites / public vars)
API_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png   # use a commercial/self-hosted tile service in production
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
NEXT_PUBLIC_SHOW_DEMO_BANNER=false
